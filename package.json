{
  "name": "commit-now-myfriend",
  "version": "0.1.4",
  "description": "AI-assisted Git commit workflow CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cnm": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "dev": "tsx src/index.ts",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "cli",
    "typescript",
    "git",
    "ai"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@clack/prompts": "^1.3.0",
    "@google/genai": "^1.51.0",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "execa": "^9.6.1",
    "openai": "^6.35.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
