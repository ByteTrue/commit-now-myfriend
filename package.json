{
  "name": "commit-now-myfriend",
  "version": "0.1.4",
  "description": "AI-assisted Git commit workflow CLI.",
  "license": "MIT",
  "bin": {
    "cnm": "scripts/cnm.js"
  },
  "files": [
    "bin",
    "scripts",
    "README.md",
    "LICENSE",
    "package.json",
    "docs/distribution.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "make go-build",
    "build:go": "make go-build",
    "build:release-local": "node scripts/pack-binary.js",
    "test": "npm run test:go && npm run test:node",
    "test:go": "make go-test",
    "test:node": "node --test scripts/*.test.js",
    "fmt": "make go-fmt",
    "fmt:go": "make go-fmt",
    "dev": "make go-run",
    "dev:go": "make go-run",
    "pack:dry-run": "npm pack --dry-run",
    "postinstall": "node scripts/npm-install.js"
  },
  "keywords": [
    "cli",
    "go",
    "git",
    "ai"
  ],
  "private": false
}
