{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "reason_codes", "evidence"],
  "properties": {
    "decision": {"enum": ["accept", "reject"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["none", "unsupported_claim", "outside_diff_context", "unverifiable_motivation", "body_unsupported", "no_specific_change"]}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    }
  }
}
